// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",
    //"height": 32, // Waybar height (to be removed for auto height)
    "spacing": 4, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
        "custom/global-menu",
        "custom/app-launcher",
        "niri/workspaces"
    ],
    "modules-center": [
        "cpu",
        "memory"
    ],
    "modules-right": [
        //"tray",
        "bluetooth",
        "pulseaudio",
        "network",
        "clock",
        "custom/session"
    ],
    //Modules configuration
    "custom/global-menu": {
        "format": "",
        "on-click": "menu-global",
        "tooltip-format": "Global Menu: Super + Alt + Space"
    },
    "custom/app-launcher": {
        "format": "󰀻",
        "on-click": "launch-launcher",
        "tooltip-format": "App Launcher: Super + Space"
    },
    "niri/workspaces": {
        "on-click": "activate",
        "cursor": true
    },
    "tray": {
        // "icon-size": 21,
        "spacing": 10
    },
    "bluetooth": {
        "format": "",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "format-no-controller": "",
        "tooltip-format": "Devices connected: {num_connections}",
        "on-click": "open-terminal-dialog bluetui"
    },
    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<span>{calendar}</span>",
        "calendar": {
            "mode": "month"
        }
    },
    "cpu": {
        "interval": 2,
        "format": " {usage:>2}<span alpha='50%'>%</span>",
        "on-click": "open-terminal-dialog btop"
    },
    "memory": {
        "interval": 2,
        "format": " {used:>2}<span alpha='50%'>G</span>",
        "tooltip-format": "Total: {total} GB\nUsed: {used} GB\nFree: {avail} GB",
        "on-click": "open-terminal-dialog btop"
    },
    "network": {
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "format": "{icon}",
        "format-wifi": "{icon}",
        "format-ethernet": "󰀂",
        "format-disconnected": "󰤮",
        "tooltip-format": "Id: {essid}\nSignal: {signalStrength}%\nIP: {ipaddr}",
        "on-click": "open-terminal-dialog impala"
    },
    "pulseaudio": {
        "format": "{icon}",
        "on-click": "open-terminal-dialog wiremix --tab output",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "tooltip-format": "Playing at {volume}%",
        "scroll-step": 2,
        "format-muted": "",
        "format-icons": {
            "default": ["", "", ""]
        }
    },
    "custom/session": {
        "format" : "",
		"tooltip-format": "Session Actions: XF86Sleep",
        "on-click": "menu-global session"
    }
}
